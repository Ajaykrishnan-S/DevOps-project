pipeline {
    agent any

    environment {
        DOCKER_IMAGE = 'ajaykrish12345/mavenwebapp'
        IMAGE_TAG = "build-${BUILD_NUMBER}"
        NEXUS_URL = 'http://IP ADDRESS:8081'
        NEXUS_REPOSITORY = 'maven-releases'
        // Replace with the exact groupId from pom.xml before running.
        NEXUS_GROUP_ID = 'REPLACE_WITH_POM_GROUP_ID'
        NEXUS_ARTIFACT_ID = 'maven-web-app'
        ARTIFACT_VERSION = "1.0.${BUILD_NUMBER}"
        // Set EKS_HOST as a Jenkins global environment variable to the CURRENT
        // private IP/DNS of the EKS Management Host.
        EKS_USER = 'ubuntu'
    }

    tools {
        maven 'Maven-3'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 45, unit: 'MINUTES')
    }

    stages {
        stage('1. Git Checkout') {
            steps {
                deleteDir()
                // Checks out the same repository/branch configured for this Jenkins job.
                checkout scm
                echo 'Source code checked out successfully.'
            }
        }

        stage('2. Maven Build and Test') {
            steps {
                sh '''
                    set -eu
                    mvn -B clean package
                    test -s target/maven-web-app.war
                    ls -lh target/maven-web-app.war
                '''
                archiveArtifacts artifacts: 'target/maven-web-app.war', fingerprint: true
            }
            post {
                always {
                    junit testResults: 'target/surefire-reports/*.xml', allowEmptyResults: true
                }
            }
        }

        stage('3. Publish and Retrieve WAR from Nexus') {
            steps {
                script {
                    if (env.NEXUS_GROUP_ID == 'REPLACE_WITH_POM_GROUP_ID') {
                        error('Set NEXUS_GROUP_ID to the actual groupId from pom.xml.')
                    }
                }
                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-credentials',
                        usernameVariable: 'NEXUS_USERNAME',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x
                        NETRC=$(mktemp)
                        trap 'rm -f "$NETRC"' EXIT
                        chmod 600 "$NETRC"
                        printf "machine IP ADDRESS login %s password %s\\n" \
                            "$NEXUS_USERNAME" "$NEXUS_PASSWORD" > "$NETRC"

                        echo "Waiting for Nexus..."
                        ready=false
                        for i in $(seq 1 30); do
                            if curl -fsS "$NEXUS_URL/service/rest/v1/status" >/dev/null; then
                                ready=true
                                break
                            fi
                            sleep 10
                        done
                        if [ "$ready" != true ]; then
                            echo "Nexus did not become ready."
                            exit 1
                        fi

                        curl --fail --silent --show-error \
                            --netrc-file "$NETRC" \
                            -X POST \
                            "$NEXUS_URL/service/rest/v1/components?repository=$NEXUS_REPOSITORY" \
                            -F "maven2.groupId=$NEXUS_GROUP_ID" \
                            -F "maven2.artifactId=$NEXUS_ARTIFACT_ID" \
                            -F "maven2.version=$ARTIFACT_VERSION" \
                            -F "maven2.asset1=@target/maven-web-app.war" \
                            -F "maven2.asset1.extension=war"

                        GROUP_PATH=$(printf '%s' "$NEXUS_GROUP_ID" | tr '.' '/')
                        DOWNLOAD_URL="$NEXUS_URL/repository/$NEXUS_REPOSITORY/$GROUP_PATH/$NEXUS_ARTIFACT_ID/$ARTIFACT_VERSION/$NEXUS_ARTIFACT_ID-$ARTIFACT_VERSION.war"

                        curl --fail --silent --show-error \
                            --netrc-file "$NETRC" \
                            -o target/maven-web-app.war \
                            "$DOWNLOAD_URL"
                        test -s target/maven-web-app.war
                        echo "WAR successfully retrieved from Nexus."
                    '''
                }
            }
        }

        stage('4. Docker Build') {
            steps {
                sh '''
                    set -eu
                    docker build -t "$DOCKER_IMAGE:$IMAGE_TAG" -t "$DOCKER_IMAGE:latest" .
                '''
            }
        }

        stage('5. Docker Push') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKERHUB_USERNAME',
                        passwordVariable: 'DOCKERHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x
                        printf '%s' "$DOCKERHUB_TOKEN" | \
                            docker login --username "$DOCKERHUB_USERNAME" --password-stdin
                        docker push "$DOCKER_IMAGE:$IMAGE_TAG"
                        docker push "$DOCKER_IMAGE:latest"
                        docker logout
                    '''
                }
            }
        }

        stage('6. Prepare Kubernetes Manifests') {
            steps {
                sh '''
                    set -eu
                    test -f k8s/deployment.yaml
                    test -f k8s/service.yaml
                    test -f k8s/hpa.yaml
                    sed "s|__IMAGE__|$DOCKER_IMAGE:$IMAGE_TAG|g" \
                        k8s/deployment.yaml > deployment-rendered.yaml
                    grep -q "$DOCKER_IMAGE:$IMAGE_TAG" deployment-rendered.yaml
                '''
            }
        }

        stage('7. Deploy to Amazon EKS') {
            steps {
                script {
                    if (!env.EKS_HOST?.trim()) {
                        error('Set EKS_HOST in Jenkins global environment variables to the current Management Host private IP/DNS.')
                    }
                }
                sshagent(credentials: ['eks-management-ssh']) {
                    sh '''
                        set -eu
                        ssh -o StrictHostKeyChecking=accept-new \
                            "$EKS_USER@$EKS_HOST" 'mkdir -p /tmp/mavenwebapp-k8s'
                        scp deployment-rendered.yaml k8s/service.yaml k8s/hpa.yaml \
                            "$EKS_USER@$EKS_HOST:/tmp/mavenwebapp-k8s/"
                    '''
                    sh '''
                        set -eu
                        ssh "$EKS_USER@$EKS_HOST" '
                            set -eu
                            kubectl apply -f /tmp/mavenwebapp-k8s/deployment-rendered.yaml
                            kubectl apply -f /tmp/mavenwebapp-k8s/service.yaml
                            kubectl rollout status deployment/mavenwebappdeployment --timeout=300s
                            kubectl apply -f /tmp/mavenwebapp-k8s/hpa.yaml
                        '
                    '''
                }
            }
        }

        stage('8. Deployment Verification') {
            steps {
                sshagent(credentials: ['eks-management-ssh']) {
                    sh '''
                        ssh "$EKS_USER@$EKS_HOST" '
                            echo "Deployments:"
                            kubectl get deployments
                            echo "Pods:"
                            kubectl get pods -o wide
                            echo "Services:"
                            kubectl get services
                            echo "HPA:"
                            kubectl get hpa
                            echo "Nodes:"
                            kubectl get nodes
                            echo "Pod resource metrics (requires Metrics Server):"
                            kubectl top pods
                        '
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'CI/CD pipeline completed successfully.'
        }
        failure {
            echo 'CI/CD pipeline failed. Check the failed stage and console output.'
        }
        always {
            echo 'Jenkins pipeline execution finished.'
        }
    }
}
